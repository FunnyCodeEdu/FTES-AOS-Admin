# Base URL của FTES-AOS-Backend (KHÔNG có dấu / cuối).
# FE gọi: {VITE_API_BASE_URL}/api/v1/auth, /api/v1/admin, /api/v1/graphql
# - Local dev: http://localhost:8080
# - apitest:   https://apitest.ftes.vn
VITE_API_BASE_URL=https://apitest.ftes.vn

# Đăng nhập Google (Google Identity Services). Bỏ trống ⇒ ẩn nút "Sign in with Google".
# Tạo tại Google Cloud Console → Credentials → OAuth client ID (Web application);
# thêm origin của Admin vào "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Đăng nhập GitHub (GitHub OAuth App). Bỏ trống ⇒ ẩn nút "Đăng nhập với GitHub".
# Callback URL của OAuth App phải là: {origin Admin}/auth/github/callback
VITE_GITHUB_CLIENT_ID=
