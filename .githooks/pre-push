#!/usr/bin/env bash
# .githooks/pre-push — chạy BUILD THẬT trước khi đẩy lên main/production.
#
# Vì sao tồn tại: CD chỉ deploy khi `npm run build` xanh, mà build đỏ thì workflow lặng lẽ dừng —
# không ai nhận ra cho tới khi phát hiện bản trên server đứng im nhiều giờ. Đã cắn 01/09/2026 ở repo
# Admin: một commit lọt qua `tsc --noEmit` nhưng `tsc -b` đỏ (biến không dùng), CD chết từ đó.
#
# Chạy `tsc -b`, KHÔNG chạy `npm run build`: chủ dự án yêu cầu không đóng gói trên VPS (nặng máy,
# CI/CD lo phần đó). `tsc -b` là ĐÚNG bước đã bắt được lỗi làm chết CD — TS6133 biến không dùng —
# nên vẫn giữ nguyên tác dụng bảo vệ với một phần nhỏ tài nguyên.
#
# KHÔNG dùng `tsc --noEmit`: nó bỏ qua noUnusedLocals và project references nên vẫn xanh trong khi
# build thật đỏ. Khác biệt này chính là chỗ đã lọt lỗi.
#
# Chỉ chạy cho main/production — bắt nhánh nháp chờ build là cách nhanh nhất khiến người ta gõ
# --no-verify thành thói quen.
#
# Bỏ qua có chủ đích: git push --no-verify
set -uo pipefail

REMOTE_REF_GUARDED=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/production) REMOTE_REF_GUARDED=1 ;;
  esac
done

[ "$REMOTE_REF_GUARDED" -eq 1 ] || exit 0

echo "[pre-push] Đẩy lên main/production — kiểm kiểu trước (bỏ qua: git push --no-verify)"
cd "$(git rev-parse --show-toplevel)" || exit 1

if npx tsc -b; then
  echo "[pre-push] Kiểu xanh — cho đẩy."
  exit 0
fi

echo ""
echo "[pre-push] KIỂU ĐỎ — KHÔNG đẩy. CD cũng sẽ chết ở đúng bước này (npm run build chạy tsc -b trước)."
exit 1
